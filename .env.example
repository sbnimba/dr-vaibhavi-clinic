# Copy to .env.local for local development. Never commit real values.
# In production these are set in the Vercel project settings.

# Gmail SMTP — used for booking alerts, status updates and reminders
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase — appointments database and staff authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required. The reminders cron endpoint refuses to send without it.
CRON_SECRET=

# Optional. Analytics is skipped entirely when this is unset.
NEXT_PUBLIC_GA_ID=

# Optional. Defaults to https://dr-vaibhavi-clinic.vercel.app
NEXT_PUBLIC_SITE_URL=
